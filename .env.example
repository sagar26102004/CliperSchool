# ---------------------------------------------------------------------------
# Local development needs none of this: with an empty environment the app runs
# fully offline on in-memory storage with the deterministic stub evaluator.
# Every variable below is a switch that swaps one implementation in the
# composition root (src/container.ts) for another.
# ---------------------------------------------------------------------------

PORT=3000

# --- AI evaluator ----------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset to run fully offline with the StubLlmClient.
# Set it to switch the LlmEvaluator to real Claude with no code change.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# --- AI evaluator: free-tier alternatives ------------------------------------
# Anthropic has no free tier. Any provider speaking the OpenAI
# chat-completions shape works through OpenAiCompatibleClient, chosen only when
# ANTHROPIC_API_KEY is absent.
#
# Google AI Studio (recommended free tier — no card, current models):
#   https://aistudio.google.com/apikey
# GEMINI_API_KEY=...
# LLM_MODEL=gemini-3.6-flash   # optional; this is the default
#
# Any other provider (Groq, Mistral, Cerebras, OpenRouter, SambaNova) needs all
# three, and no code change:
# LLM_API_KEY=...
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Fault-injection switch used by the reliability demo and tests.
# Values: off | throw | malformed | slow
LLM_FAILURE_MODE=off

# When true, a model outage fails the evaluation instead of degrading it.
# Combined with LLM_FAILURE_MODE=throw this demonstrates the Failed state and
# the retry action end to end.
# LLM_REQUIRED=false

# --- Storage ---------------------------------------------------------------
# Storage is chosen by presence: with no credentials the app uses in-memory
# repositories, which is correct locally and WRONG on a serverless host, where
# consecutive requests may land on different instances.
#
# Attaching a Redis store from the Vercel dashboard (Storage -> Marketplace ->
# Upstash) injects these automatically; `vercel env pull .env.local` brings
# them down for local use. KV_REST_API_* and REDIS_REST_* are also accepted.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...
